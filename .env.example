# PostgreSQL (transactional data: users, orgs, products, matches, alerts)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pricing_intelligence

# ClickHouse (analytics: price observations, historical time-series data)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=pricing_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# Redis (cache + Celery job queue)
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP (required only for email-enabled alert rules)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
